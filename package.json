{
  "name": "vnc-viewer",
  "version": "0.1.2",
  "description": "跨平台 VNC 查看器 - 参考 UltraVNC 实现",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "test": "npm run build && node scripts/decoder-sanity-test.js && node scripts/rfb-connection-test.js",
    "test:decoders": "npm run build && node scripts/decoder-sanity-test.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron-builder --dir --publish never && open release/mac-arm64/VNC\\ Viewer.app || open release/mac/VNC\\ Viewer.app",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:mac-arm64": "npm run build && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug && echo 'APK: android/app/build/outputs/apk/debug/app-debug.apk'",
    "build:mobile": "mkdir -p dist/mobile && cp src/mobile/index.html dist/mobile/ 2>/dev/null || true"
  },
  "author": {
    "name": "higkoo",
    "email": "higkoo@users.noreply.github.com"
  },
  "license": "MIT",
  "build": {
    "appId": "com.higkoo.vncviewer",
    "productName": "VNC Viewer",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "src/renderer/**/*.html",
      "src/renderer/styles/**/*.css",
      "src/mobile/**/*.html",
      "package.json",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": null,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "gatekeeperAssess": false,
      "icon": "build/icon.icns"
    },
    "dmg": {
      "title": "VNC Viewer ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icons/512x512.png"
    }
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@types/jpeg-js": "^0.3.0",
    "@types/ws": "^8.18.1",
    "electron": "~32.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "pako": "^2.2.0",
    "ws": "^8.21.3"
  }
}
